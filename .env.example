# Required. Supply real project values locally; never commit .env.local.
APP_ENV=
APP_BASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
LOG_LEVEL=
